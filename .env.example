# PostgreSQL 数据库
POSTGRES_DB=agent_platform
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_dev_password
DATABASE_URL=postgres://agent:agent_dev_password@localhost:5432/agent_platform?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_CONN_MAX_IDLE_TIME=10m

# Redis：LLMGateway 的分布式令牌桶限流。
REDIS_URL=redis://localhost:6379/0

# 应用基础配置
HTTP_ADDR=:8080
LOG_LEVEL=info
# JSON 日志同时写入标准输出，并按本地日期写入独立日志文件。
LOG_DIR=./logs
LOG_RETENTION_DAYS=30
# 单轮用户请求最多允许执行的服务端工具调用轮数。
MAX_TOOL_ITERATIONS=4
# 连接模型供应商、TLS 握手以及等待响应头的超时时间。
STREAM_CONNECT_TIMEOUT=10s
# 从收到供应商响应头到收到首个协议事件的超时时间（TTFT）。
STREAM_TTFT_TIMEOUT=30s
# 一次完整模型/工具流式调用允许的最大业务时长。
STREAM_TOTAL_TIMEOUT=5m
# 浏览器携带 sequence 重连时使用的短期事件补发缓存。
STREAM_CACHE_TTL=5m
STREAM_CACHE_MAX_EVENTS=10000
# LLMGateway 准入控制：调用供应商前先按估算 Token 扣减预算和限流桶。
# 本地调试时可将两个限流值设为 0，以关闭基于 Redis 的限流。
LLM_TOKEN_BUDGET=32768
LLM_MAX_OUTPUT_TOKENS=4096
LLM_RATE_TOKENS_PER_MINUTE=120000
LLM_RATE_BURST=120000
LLM_IDEMPOTENCY_TTL=24h
# 仅同步请求的网络故障会自动重试，流式请求不会自动重放。
LLM_SYNC_MAX_RETRIES=1
LLM_RETRY_BACKOFF=200ms
# 长对话压缩：摘要可使用独立模型，生成和质量评估的用量、成本会计入助手消息。
CONTEXT_SUMMARY_ENABLED=true
# 两项都留空时复用当前对话模型；同时配置后，摘要与质量评估会路由到指定的低成本模型。
CONTEXT_SUMMARY_PROVIDER=
CONTEXT_SUMMARY_MODEL=
CONTEXT_SUMMARY_MAX_TOKENS=1024
CONTEXT_KEEP_RECENT_MESSAGES=8
CONTEXT_SUMMARY_MAX_CALLS=2
CONTEXT_SUMMARY_QUALITY_ENABLED=true
CONTEXT_SUMMARY_QUALITY_THRESHOLD=70
CONTEXT_SUMMARY_QUALITY_MAX_TOKENS=256
# 请求支持的模型返回推理摘要；这会增加延迟和输出 Token 成本。
# 不支持该能力的供应商或模型仍按普通对话处理。
ENABLE_THINKING=false
# Anthropic 内部推理预算，取值范围为 1024～4095 Token。
THINKING_BUDGET_TOKENS=2048
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_TTL_HOURS=168
CORS_ALLOWED_ORIGINS=http://localhost:5173
SYSTEM_PROMPT=You are a helpful AI assistant.

# 仅填写需要启用的模型供应商密钥；未配置密钥的供应商不会展示给前端。
# OpenAI 模型供应商
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o-mini
# 模型容量格式：模型名:上下文窗口:最大输出Token
OPENAI_MODEL_LIMITS=gpt-4o-mini:32768:4096
# Tokenizer 格式：模型名:tokenizer。支持 o200k_base、cl100k_base、
# p50k_base、r50k_base、deepseek_v4、heuristic；无官方或兼容词表时使用 heuristic。
OPENAI_MODEL_TOKENIZERS=gpt-4o-mini:o200k_base
# 价格格式：模型名:每百万输入Token美元价格:每百万输出Token美元价格
# 价格未知时可以留空，系统仍会记录 Token 用量。
OPENAI_MODEL_PRICING=
# 仅当 OpenAI 兼容接口拒绝 stream_options 参数时设为 false。
OPENAI_STREAM_INCLUDE_USAGE=true

# Kimi 模型供应商
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODELS=moonshot-v1-8k
KIMI_MODEL_LIMITS=moonshot-v1-8k:8192:4096
KIMI_MODEL_TOKENIZERS=moonshot-v1-8k:heuristic
KIMI_MODEL_PRICING=
KIMI_STREAM_INCLUDE_USAGE=true

# Anthropic 模型供应商
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODELS=claude-sonnet-4-20250514
ANTHROPIC_MODEL_LIMITS=claude-sonnet-4-20250514:32768:4096
ANTHROPIC_MODEL_TOKENIZERS=claude-sonnet-4-20250514:heuristic
ANTHROPIC_MODEL_PRICING=

# DeepSeek 模型供应商
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODELS=deepseek-v4-flash
DEEPSEEK_MODEL_LIMITS=deepseek-v4-flash:32768:4096
DEEPSEEK_MODEL_TOKENIZERS=deepseek-v4-flash:deepseek_v4
DEEPSEEK_MODEL_PRICING=
DEEPSEEK_STREAM_INCLUDE_USAGE=true

# 智谱 GLM 模型供应商
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 仅 GLM-4.5 及以上版本和 GLM-5 系列模型会请求推理内容。
GLM_MODELS=glm-4-flash
GLM_MODEL_LIMITS=glm-4-flash:32768:4096
GLM_MODEL_TOKENIZERS=glm-4-flash:heuristic
GLM_MODEL_PRICING=
GLM_STREAM_INCLUDE_USAGE=true
