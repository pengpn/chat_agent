# PostgreSQL 数据库
POSTGRES_DB=agent_platform
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_dev_password
DATABASE_URL=postgres://agent:agent_dev_password@localhost:5432/agent_platform?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_CONN_MAX_IDLE_TIME=10m

# Redis：LLMGateway 的分布式令牌桶限流。
REDIS_URL=redis://localhost:6379/0

# MinIO/S3 兼容对象存储：原始附件写入对象存储，数据库只保存元数据和提取文本。
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=agent_minio
OBJECT_STORAGE_SECRET_KEY=agent_minio_password
OBJECT_STORAGE_BUCKET=chat-attachments
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_SSL=false
# 单文件最大字节数、单条消息最大附件数、文档提取文本最大字符数。
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_COUNT=5
ATTACHMENT_MAX_TEXT_CHARS=200000

# 应用基础配置
HTTP_ADDR=:8080
LOG_LEVEL=info
# JSON 日志同时写入标准输出，并按本地日期写入独立日志文件。
LOG_DIR=./logs
LOG_RETENTION_DAYS=30
# 单轮用户请求最多允许执行的服务端工具调用轮数。
MAX_TOOL_ITERATIONS=4
# 连接模型供应商、TLS 握手以及等待响应头的超时时间。
STREAM_CONNECT_TIMEOUT=10s
# 从收到供应商响应头到收到首个协议事件的超时时间（TTFT）。
STREAM_TTFT_TIMEOUT=30s
# 一次完整模型/工具流式调用允许的最大业务时长。
STREAM_TOTAL_TIMEOUT=5m
# 浏览器携带 sequence 重连时使用的短期事件补发缓存。
STREAM_CACHE_TTL=5m
STREAM_CACHE_MAX_EVENTS=10000
# 用户级 SSE 事件短期补发缓存，用于标题等后台任务通知。
USER_EVENT_TTL=10m
USER_EVENT_MAX_EVENTS=1000
# LLMGateway 准入控制：调用供应商前先按估算 Token 扣减预算和限流桶。
# 本地调试时可将两个限流值设为 0，以关闭基于 Redis 的限流。
LLM_TOKEN_BUDGET=32768
LLM_MAX_OUTPUT_TOKENS=4096
LLM_RATE_TOKENS_PER_MINUTE=120000
LLM_RATE_BURST=120000
LLM_IDEMPOTENCY_TTL=24h
# 仅同步请求的网络故障会自动重试，流式请求不会自动重放。
LLM_SYNC_MAX_RETRIES=1
LLM_RETRY_BACKOFF=200ms

# RAG Embedding：独立于聊天模型配置；本地未提供独立 API Key 时默认关闭。
# 使用知识文档上传与摄取前，需要设置 EMBEDDING_ENABLED=true。
# 可接入任意兼容 OpenAI POST /embeddings 的服务；启用时必须填写独立 API Key。
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 写入 pgvector 前强制校验的向量维度；必须与模型实际输出一致。
EMBEDDING_DIMENSION=1536
# text-embedding-3 支持 dimensions；兼容服务不接受该字段时设为 false。
# 通义千问可改为 EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1、
# EMBEDDING_MODEL=text-embedding-v4、EMBEDDING_DIMENSION=1024、EMBEDDING_BATCH_SIZE=10。
EMBEDDING_SEND_DIMENSIONS=true
# 支持 cl100k_base、o200k_base、p50k_base、r50k_base、heuristic。
EMBEDDING_TOKENIZER=cl100k_base
# 一次业务调用最大文本数，以及单次供应商请求的最大文本数。
EMBEDDING_MAX_INPUTS=2048
EMBEDDING_BATCH_SIZE=64
# 单条文本与单个供应商批次的请求前 Token 上限。
EMBEDDING_MAX_INPUT_TOKENS=8191
EMBEDDING_MAX_BATCH_TOKENS=100000
# 连接超时、单批总超时，以及幂等 Embedding 请求的受控重试策略。
EMBEDDING_CONNECT_TIMEOUT=10s
EMBEDDING_REQUEST_TIMEOUT=30s
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BACKOFF=300ms
# Redis 内容哈希向量缓存保留时间；缓存按用户、Provider、模型和维度隔离。
EMBEDDING_CACHE_TTL=720h
# 每百万输入 Token 的美元价格；留空时记录 Token，但成本标记为未知。
EMBEDDING_INPUT_USD_PER_MILLION_TOKENS=

# RAG 文档摄取：配置与一次性对话附件分离，适合更大的长期知识文档。
# 原始文件最大字节数，以及提取后允许保留的最大 Unicode 字符数。
RAG_DOCUMENT_MAX_BYTES=20971520
RAG_DOCUMENT_MAX_TEXT_CHARS=1000000
# 分块大小使用 Embedding tokenizer 的 Token 作为单位；重叠必须小于目标大小。
RAG_CHUNK_TARGET_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=80
RAG_CHUNK_MIN_TOKENS=40
# 单个摄取任务每次交给 EmbeddingGateway 的分块数，以及任务总超时。
RAG_EMBEDDING_JOB_BATCH_SIZE=256
RAG_INGESTION_TIMEOUT=10m
# RAG 精确向量检索：先取候选，再按阈值、Top-K 和上下文 Token 预算筛选。
RAG_RETRIEVAL_CANDIDATE_LIMIT=30
RAG_RETRIEVAL_TOP_K=5
# 余弦相似度范围配置为 0～1；低于阈值的片段不会为了凑数进入上下文。
RAG_RETRIEVAL_SIMILARITY_THRESHOLD=0.35
RAG_RETRIEVAL_CONTEXT_TOKEN_BUDGET=3000
# 单次检索允许选择的知识库数量和问题最大 Unicode 字符数。
RAG_RETRIEVAL_MAX_KNOWLEDGE_BASES=8
RAG_RETRIEVAL_MAX_QUERY_CHARS=4000
# 仅在受控调试时开启：会把查询和候选文档内容写入日志，可能包含用户敏感资料。
RAG_RETRIEVAL_TRACE_ENABLED=false

# 长对话压缩：摘要可使用独立模型，生成和质量评估的用量、成本会计入助手消息。
CONTEXT_SUMMARY_ENABLED=true
# 两项都留空时复用当前对话模型；同时配置后，摘要与质量评估会路由到指定的低成本模型。
CONTEXT_SUMMARY_PROVIDER=
CONTEXT_SUMMARY_MODEL=
CONTEXT_SUMMARY_MAX_TOKENS=1024
CONTEXT_KEEP_RECENT_MESSAGES=8
CONTEXT_SUMMARY_MAX_CALLS=2
CONTEXT_SUMMARY_QUALITY_ENABLED=true
CONTEXT_SUMMARY_QUALITY_THRESHOLD=70
CONTEXT_SUMMARY_QUALITY_MAX_TOKENS=256
# 对话标题：首个成功回答落库后异步调用模型生成标题。
# Provider 和 Model 同时留空时复用首个成功回答所使用的模型；同时配置可路由到更便宜的小模型。
TITLE_GENERATION_PROVIDER=
TITLE_GENERATION_MODEL=
# 标题模型最大输出 Token、最终标题最大字符数，以及后台任务超时时间。
TITLE_GENERATION_MAX_TOKENS=64
TITLE_GENERATION_MAX_LENGTH=40
TITLE_GENERATION_TIMEOUT=15s

# 用户额度与并发：请求前按估算 Token 预扣，完成后按实际用量结算，失败时补偿。
# 额度与限流的分工：限流控单位时间请求次数，额度控累计 Token 用量，并发限制控同时生成的请求数。
QUOTA_ENABLED=true
# 未被管理员覆盖的用户沿用的日/月 Token 额度。
QUOTA_DEFAULT_DAILY_TOKENS=200000
QUOTA_DEFAULT_MONTHLY_TOKENS=3000000
# 单用户同时处于生成中的请求上限（含重新生成和编辑）。
QUOTA_MAX_CONCURRENT_GENERATIONS=2

# 生成类接口的按用户固定窗口限流；设为 0 关闭。
CHAT_RATE_LIMIT=30
CHAT_RATE_LIMIT_WINDOW=1m
# 生成类接口单个请求体最大字节数，超限返回 413。
CHAT_BODY_MAX_BYTES=2097152
# 单条用户消息最大字符数。
MESSAGE_MAX_CHARS=100000

# 工具调用安全：参数最大字节数、结果最大字节数（超出截断）、单次执行超时。
TOOL_ARGUMENT_MAX_BYTES=65536
TOOL_RESULT_MAX_BYTES=32768
TOOL_EXECUTION_TIMEOUT=30s
# 仅管理员可调用的工具名列表，逗号分隔；留空表示全部工具对所有用户开放。
TOOL_ADMIN_ONLY=

# 内容审核：输入在落库前拦截，输出在落库前替换为固定提示文案。
MODERATION_ENABLED=true
# 逗号分隔的拦截词表，大小写不敏感；请按合规要求配置。
MODERATION_INPUT_BLOCKLIST=
MODERATION_OUTPUT_BLOCKLIST=

# 管理员引导：下列邮箱在注册或登录时自动获得管理员角色。
ADMIN_EMAILS=

# 告警：单条消息成本超过阈值（纳美元，1 美元 = 1e9）时输出运营告警日志；0 表示关闭。
ALERT_COST_THRESHOLD_NANO_USD=100000000
# 请求支持的模型返回推理摘要；这会增加延迟和输出 Token 成本。
# 不支持该能力的供应商或模型仍按普通对话处理。
ENABLE_THINKING=false
# Anthropic 内部推理预算，取值范围为 1024～4095 Token。
THINKING_BUDGET_TOKENS=2048
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
# Access Token 保持短期有效；Refresh Token 使用 HttpOnly Cookie 并在每次刷新时轮换。
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REFRESH_COOKIE_NAME=agent_refresh
# 生产 HTTPS 环境必须设为 true；本地 HTTP 开发保持 false。
REFRESH_COOKIE_SECURE=false

# 账号邮件与一次性链接。log 仅用于本地开发，会把链接写入结构化日志。
PUBLIC_WEB_URL=http://localhost:5173
EMAIL_DELIVERY_MODE=log
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=30m
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 登录、注册、忘记/重置密码的 Redis 固定窗口限流。
AUTH_RATE_LIMIT_WINDOW=15m
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_PASSWORD_RESET_RATE_LIMIT=5

# 已撤销会话和已使用一次性 Token 的保留天数；过期凭据会在启动时直接清理。
AUTH_CREDENTIAL_RETENTION_DAYS=30

# 账号注销后仍保留不含邮箱等身份信息的安全审计记录天数。
ACCOUNT_AUDIT_RETENTION_DAYS=365
CORS_ALLOWED_ORIGINS=http://localhost:5173
SYSTEM_PROMPT=You are a helpful AI assistant.

# 仅填写需要启用的模型供应商密钥；未配置密钥的供应商不会展示给前端。
# OpenAI 模型供应商
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o-mini
# 仅列出已在 OPENAI_MODELS 中启用且支持图片输入的模型。
OPENAI_VISION_MODELS=gpt-4o-mini
# 模型容量格式：模型名:上下文窗口:最大输出Token
OPENAI_MODEL_LIMITS=gpt-4o-mini:32768:4096
# Tokenizer 格式：模型名:tokenizer。支持 o200k_base、cl100k_base、
# p50k_base、r50k_base、deepseek_v4、heuristic；无官方或兼容词表时使用 heuristic。
OPENAI_MODEL_TOKENIZERS=gpt-4o-mini:o200k_base
# 价格格式：模型名:每百万输入Token美元价格:每百万输出Token美元价格
# 价格未知时可以留空，系统仍会记录 Token 用量。
OPENAI_MODEL_PRICING=
# 仅当 OpenAI 兼容接口拒绝 stream_options 参数时设为 false。
OPENAI_STREAM_INCLUDE_USAGE=true

# 通义千问（阿里云百炼）视觉模型。API Key 在百炼控制台创建。
# 默认地址适用于华北 2（北京）；使用其他地域或工作空间专属域名时请替换 BASE_URL。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODELS=qwen3-vl-flash
# 官方上下文长度 262144，最大输出 32768 Token。
QWEN_MODEL_LIMITS=qwen3-vl-flash:262144:32768
# 暂无接入本地官方 tokenizer，调用前使用保守估算，最终用量以百炼 usage 为准。
QWEN_MODEL_TOKENIZERS=qwen3-vl-flash:heuristic
QWEN_MODEL_PRICING=
QWEN_STREAM_INCLUDE_USAGE=true
QWEN_VISION_MODELS=qwen3-vl-flash

# Kimi 模型供应商
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODELS=moonshot-v1-8k
KIMI_VISION_MODELS=
KIMI_MODEL_LIMITS=moonshot-v1-8k:8192:4096
KIMI_MODEL_TOKENIZERS=moonshot-v1-8k:heuristic
KIMI_MODEL_PRICING=
KIMI_STREAM_INCLUDE_USAGE=true

# Anthropic 模型供应商
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODELS=claude-sonnet-4-20250514
ANTHROPIC_VISION_MODELS=claude-sonnet-4-20250514
ANTHROPIC_MODEL_LIMITS=claude-sonnet-4-20250514:32768:4096
ANTHROPIC_MODEL_TOKENIZERS=claude-sonnet-4-20250514:heuristic
ANTHROPIC_MODEL_PRICING=

# DeepSeek 模型供应商
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODELS=deepseek-v4-flash
DEEPSEEK_VISION_MODELS=
DEEPSEEK_MODEL_LIMITS=deepseek-v4-flash:32768:4096
DEEPSEEK_MODEL_TOKENIZERS=deepseek-v4-flash:deepseek_v4
DEEPSEEK_MODEL_PRICING=
DEEPSEEK_STREAM_INCLUDE_USAGE=true

# 智谱 GLM 模型供应商
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 仅 GLM-4.5 及以上版本和 GLM-5 系列模型会请求推理内容。
GLM_MODELS=glm-4-flash
GLM_VISION_MODELS=
GLM_MODEL_LIMITS=glm-4-flash:32768:4096
GLM_MODEL_TOKENIZERS=glm-4-flash:heuristic
GLM_MODEL_PRICING=
GLM_STREAM_INCLUDE_USAGE=true
