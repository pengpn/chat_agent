# PostgreSQL
POSTGRES_DB=agent_platform
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_dev_password
DATABASE_URL=postgres://agent:agent_dev_password@localhost:5432/agent_platform?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_CONN_MAX_IDLE_TIME=10m

# Redis：LLMGateway 的分布式令牌桶限流。
REDIS_URL=redis://localhost:6379/0

# Application
HTTP_ADDR=:8080
LOG_LEVEL=info
# JSON logs are written to stdout and to one file per local date.
LOG_DIR=./logs
LOG_RETENTION_DAYS=30
# One user turn can request at most this many server-side tool rounds.
MAX_TOOL_ITERATIONS=4
# Supplier connection, TLS handshake, and response-header timeout.
STREAM_CONNECT_TIMEOUT=10s
# Time from successful supplier response headers to the first protocol event.
STREAM_TTFT_TIMEOUT=30s
# Maximum business duration for the complete model/tool streaming turn.
STREAM_TOTAL_TIMEOUT=5m
# Short-lived replay cache used when the browser reconnects with a sequence.
STREAM_CACHE_TTL=5m
STREAM_CACHE_MAX_EVENTS=10000
# LLMGateway admission control. Token budget and rate buckets are charged from
# an estimate before calling a supplier. Set the rate values to 0 to disable
# Redis-backed rate limiting for local experiments.
LLM_TOKEN_BUDGET=32768
LLM_MAX_OUTPUT_TOKENS=4096
LLM_RATE_TOKENS_PER_MINUTE=120000
LLM_RATE_BURST=120000
LLM_IDEMPOTENCY_TTL=24h
# Only non-streaming network failures are retried; streams are never replayed.
LLM_SYNC_MAX_RETRIES=1
LLM_RETRY_BACKOFF=200ms
# Ask supported models to return a reasoning summary. This increases latency and
# output-token cost; unsupported Providers/models continue with normal chat.
ENABLE_THINKING=false
# Anthropic's internal reasoning budget. It must be between 1024 and 4095.
THINKING_BUDGET_TOKENS=2048
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_TTL_HOURS=168
CORS_ALLOWED_ORIGINS=http://localhost:5173
SYSTEM_PROMPT=You are a helpful AI assistant.

# Add the keys for the providers you want to expose. A provider without a key is hidden.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o-mini
# model:input_usd_per_million_tokens:output_usd_per_million_tokens
# Leave empty when a model price is unknown; token usage will still be recorded.
OPENAI_MODEL_PRICING=
# Disable only when an OpenAI-compatible endpoint rejects stream_options.
OPENAI_STREAM_INCLUDE_USAGE=true

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODELS=moonshot-v1-8k
KIMI_MODEL_PRICING=
KIMI_STREAM_INCLUDE_USAGE=true

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODELS=claude-sonnet-4-20250514
ANTHROPIC_MODEL_PRICING=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODELS=deepseek-v4-flash
DEEPSEEK_MODEL_PRICING=
DEEPSEEK_STREAM_INCLUDE_USAGE=true

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Thinking is requested only for GLM-4.5+ and GLM-5 models.
GLM_MODELS=glm-4-flash
GLM_MODEL_PRICING=
GLM_STREAM_INCLUDE_USAGE=true
